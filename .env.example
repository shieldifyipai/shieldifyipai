# Browser-visible route. Keep this as the same-origin Vercel Function by default.
PUBLIC_CONTACT_FORM_ENDPOINT=/api/contact

# Optional: paste the verification token from Google Search Console, not the full meta tag.
PUBLIC_GOOGLE_SITE_VERIFICATION=

# Server-only Vercel Environment Variables. Never prefix these with PUBLIC_.
RESEND_API_KEY=
CONTACT_TO_EMAIL=info@shieldifyip.ai
CONTACT_FROM_EMAIL=Shieldify IP <info@shieldifyip.ai>
CONTACT_ALLOWED_ORIGINS=https://shieldifyip.ai,https://www.shieldifyip.ai
