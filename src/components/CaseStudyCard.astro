---
interface Props {
  title: string;
  description: string;
  href: string;
  image: string;
  imageAlt: string;
  imageWidth: number;
  imageHeight: number;
  category: string;
  industry: string;
  channels?: string[];
}

const {
  title,
  description,
  href,
  image,
  imageAlt,
  imageWidth,
  imageHeight,
  category,
  industry,
  channels = [],
} = Astro.props;
const searchText = `${title} ${description} ${category} ${industry} ${channels.join(' ')}`.toLowerCase();
---

<article
  class="case-card reveal"
  data-case-item
  data-category={category.toLowerCase()}
  data-search={searchText}
>
  <a class="case-card__media" href={href} tabindex="-1" aria-hidden="true">
    <img src={image} alt={imageAlt} width={imageWidth} height={imageHeight} loading="lazy" decoding="async" />
    <span>Illustrative workflow</span>
  </a>
  <div class="case-card__body">
    <div class="case-card__meta"><span>{category}</span><span>{industry}</span></div>
    <h2><a href={href}>{title}</a></h2>
    <p>{description}</p>
    <div class="case-card__channels" aria-label="Channels">
      {channels.slice(0, 3).map((channel) => <span>{channel}</span>)}
    </div>
    <a class="case-card__link" href={href}>View case workflow <span aria-hidden="true">→</span></a>
  </div>
</article>

<style>
  .case-card{display:flex;flex-direction:column;overflow:hidden;border:1px solid var(--border);border-radius:15px;background:var(--surface);transition:transform .25s ease,border-color .25s ease,box-shadow .25s ease}.case-card:hover{transform:translateY(-5px);border-color:rgba(185,251,106,.32);box-shadow:0 18px 45px rgba(0,0,0,.25)}.case-card[hidden]{display:none}.case-card__media{position:relative;overflow:hidden;aspect-ratio:16/9;background:var(--surface-2)}.case-card__media img{width:100%;height:100%;object-fit:cover;transition:transform .45s ease}.case-card:hover .case-card__media img{transform:scale(1.025)}.case-card__media>span{position:absolute;top:16px;left:16px;padding:6px 10px;border:1px solid rgba(255,255,255,.18);border-radius:999px;background:rgba(9,13,22,.84);color:#fff;font-size:10px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;backdrop-filter:blur(8px)}.case-card__body{display:flex;flex:1;flex-direction:column;padding:30px}.case-card__meta{display:flex;flex-wrap:wrap;gap:8px;color:var(--lime);font-size:11px}.case-card__meta span+span::before{margin-right:8px;color:var(--muted);content:'•'}.case-card h2{margin:16px 0 14px;font-size:25px;line-height:1.28}.case-card p{font-size:14px}.case-card__channels{display:flex;flex-wrap:wrap;gap:7px;margin-top:20px}.case-card__channels span{padding:5px 9px;border:1px solid var(--border);border-radius:999px;font-size:10px}.case-card__link{display:inline-flex;align-items:center;gap:8px;margin-top:auto;padding-top:24px;color:var(--lime);font-size:13px;font-weight:700}@media(max-width:600px){.case-card__body{padding:24px 22px}.case-card h2{font-size:21px}}
</style>
