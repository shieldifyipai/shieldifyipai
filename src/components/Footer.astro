---
import CTASection from './CTASection.astro';
import { companyNavigation, industryNavigation, resourceNavigation, serviceNavigation } from '@/data/site';
---
<footer class="site-footer">
  <CTASection />
  <div class="footer-main container">
    <div class="footer-brand">
      <a class="site-logo" href="/"><img src="/images/logo.svg" alt="Shieldify IP" width="141" height="34" loading="lazy" decoding="async" /></a>
      <p>Technology-driven intellectual property protection for brands operating across digital platforms.</p>
      <div class="socials" aria-label="Social media"><a href="#" aria-label="Facebook">f</a><a href="#" aria-label="X">𝕏</a><a href="#" aria-label="LinkedIn">in</a><a href="#" aria-label="YouTube">▶</a></div>
    </div>
    <div><h2>Services</h2><ul>{serviceNavigation.map((item) => <li><a href={item.href}>{item.label}</a></li>)}</ul></div>
    <div><h2>Industries</h2><ul><li><a href="/industries">All Industries</a></li>{industryNavigation.map((item) => <li><a href={item.href}>{item.label}</a></li>)}</ul></div>
    <div><h2>Company</h2><ul>{companyNavigation.map((item) => <li><a href={item.href}>{item.label}</a></li>)}<li><a href="/case-studies">Case Studies</a></li></ul></div>
    <div><h2>Resources</h2><ul>{resourceNavigation.map((item) => <li><a href={item.href}>{item.label}</a></li>)}<li><a href="/privacy-policy">Privacy Policy</a></li><li><a href="/user-agreement">User Agreement</a></li><li><a href="/rss.xml">RSS Feed</a></li></ul></div>
  </div>
  <div class="footer-wordmark container"><img src="/images/footer-wordmark.svg" alt="" width="1536" height="310" loading="lazy" decoding="async" /></div>
  <div class="footer-bottom"><div class="container"><span>Shieldify IP Co., Ltd | 2026 © All rights reserved</span><a href="#main-content">Back to top <b aria-hidden="true">↑</b></a></div></div>
</footer>
