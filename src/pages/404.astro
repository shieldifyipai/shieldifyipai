---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
---
<BaseLayout title="Page Not Found" description="The requested page could not be found." noindex>
  <section class="not-found container"><span class="eyebrow">404 Error</span><h1>Page Not Found</h1><p>The page you are looking for may have moved or no longer exists.</p><Button href="/">Back to Home</Button></section>
</BaseLayout>
<style>.not-found{min-height:750px;padding-top:230px;text-align:center}.not-found h1{font-size:75px;margin:20px 0}.not-found p{margin-bottom:28px}@media(max-width:600px){.not-found h1{font-size:43px}}</style>
