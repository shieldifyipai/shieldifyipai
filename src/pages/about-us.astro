---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AboutContent from '@/sections/about/AboutContent.astro';
import { site } from '@/data/site';

const pageDescription = 'Learn how Shieldify IP combines technology-assisted monitoring, evidence workflows, professional case review, and transparent reporting to protect intellectual property.';
const aboutSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  url: `${site.url}/about-us`,
  name: `About – ${site.name}`,
  description: pageDescription,
  inLanguage: 'en',
  isPartOf: { '@id': `${site.url}/#website` },
  about: { '@id': `${site.url}/#organization` },
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
    { '@type': 'ListItem', position: 2, name: 'About', item: `${site.url}/about-us` },
  ],
};
---
<BaseLayout
  title="About"
  metaTitle="About Shieldify IP - Digital IP Operations"
  description={pageDescription}
  image="/images/og/shieldify-ip.jpg"
  imageAlt="Shieldify IP digital intellectual property operations"
  canonicalPath="/about-us"
  schema={[aboutSchema, breadcrumbSchema]}
>
  <AboutContent />
</BaseLayout>
