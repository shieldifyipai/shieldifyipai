---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import BlogCard from '@/components/BlogCard.astro';
import Button from '@/components/Button.astro';
import { site } from '@/data/site';

const posts = (await getCollection('blog')).sort((a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf());
const categories = [...new Set(posts.map((post) => post.data.category))].sort();
const tagCounts = new Map<string, number>();

posts.forEach((post) => {
  post.data.tags.forEach((tag) => tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1));
});

const tags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Shieldify IP Blog',
  description: 'Practical guidance on trademark protection, copyright enforcement, online counterfeits, and digital evidence workflows.',
  url: `${site.url}/blog`,
  hasPart: posts.map((post) => ({
    '@type': 'BlogPosting',
    headline: post.data.title,
    url: `${site.url}/blog/${post.id}`,
    datePublished: post.data.publishedDate.toISOString(),
  })),
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${site.url}/blog` },
  ],
};
---

<BaseLayout
  title="Blog"
  description="Practical guidance on trademark protection, copyright enforcement, brand monitoring, counterfeit detection, and digital evidence workflows."
  schema={[collectionSchema, breadcrumbSchema]}
>
  <section class="blog-hero">
    <div class="container">
      <span class="eyebrow">Knowledge Center</span>
      <h1>IP Protection Insights</h1>
      <p>Practical guidance for teams monitoring trademarks, copyrighted content, counterfeit listings, and digital brand misuse.</p>
      <nav aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">•</span><strong>Blog</strong></nav>
    </div>
  </section>

  <section class="blog-section" data-blog-root>
    <div class="container">
      <div class="blog-tools">
        <form class="blog-search" role="search" data-blog-search-form>
          <label>
            <span class="sr-only">Search articles</span>
            <input type="search" name="q" placeholder="Search by topic or keyword" autocomplete="off" data-blog-search />
          </label>
          <button type="submit" aria-label="Search articles">Search</button>
        </form>
        <p class="blog-count" aria-live="polite" data-result-count>{posts.length} articles</p>
      </div>

      <div class="category-filters" aria-label="Filter by category">
        <button type="button" class="is-active" data-category-filter="" aria-pressed="true">All topics</button>
        {categories.map((category) => <button type="button" data-category-filter={category.toLowerCase()} aria-pressed="false">{category}</button>)}
      </div>

      <div class="blog-layout">
        <div class="blog-results">
          <div class="blog-grid" id="blog-grid">
            {posts.map((post) => (
              <BlogCard
                title={post.data.title}
                description={post.data.description}
                date={post.data.publishedDate}
                image={post.data.image}
                imageAlt={post.data.imageAlt}
                imageWidth={post.data.imageWidth}
                imageHeight={post.data.imageHeight}
                category={post.data.category}
                tags={post.data.tags}
                href={`/blog/${post.id}`}
              />
            ))}
          </div>

          <div class="nothing" data-empty-state hidden>
            <span aria-hidden="true">⌕</span>
            <h2>No matching articles</h2>
            <p>Try a broader keyword or clear the selected filters.</p>
            <button type="button" data-clear-filters>Clear filters</button>
          </div>
        </div>

        <aside class="sidebar" aria-label="Blog navigation">
          <section>
            <h2>Latest Articles</h2>
            <ol class="recent-posts">
              {posts.slice(0, 4).map((post) => (
                <li>
                  <a href={`/blog/${post.id}`}>{post.data.title}</a>
                  <time datetime={post.data.publishedDate.toISOString()}>{post.data.publishedDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</time>
                </li>
              ))}
            </ol>
          </section>

          <section>
            <h2>Popular Tags</h2>
            <div class="tag-list">
              {tags.map(([tag, count]) => (
                <button type="button" data-tag-filter={tag.toLowerCase()} aria-pressed="false">{tag}<span>{count}</span></button>
              ))}
            </div>
          </section>

          <section class="sidebar-cta">
            <span class="eyebrow">Need Support?</span>
            <h2>Turn a Finding Into an Actionable Case</h2>
            <p>Share the asset, URL, or infringement concern you want reviewed.</p>
            <Button href="/our-services#contact">Request a Consultation</Button>
          </section>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-blog-root]');

  if (root) {
    const searchForm = root.querySelector<HTMLFormElement>('[data-blog-search-form]');
    const searchInput = root.querySelector<HTMLInputElement>('[data-blog-search]');
    const items = [...root.querySelectorAll<HTMLElement>('[data-blog-item]')];
    const categoryButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-category-filter]')];
    const tagButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-tag-filter]')];
    const resultCount = root.querySelector<HTMLElement>('[data-result-count]');
    const emptyState = root.querySelector<HTMLElement>('[data-empty-state]');
    const clearButton = root.querySelector<HTMLButtonElement>('[data-clear-filters]');
    const initialParams = new URLSearchParams(window.location.search);
    let activeCategory = (initialParams.get('category') ?? '').toLowerCase();
    let activeTag = (initialParams.get('tag') ?? '').toLowerCase();

    if (searchInput) searchInput.value = initialParams.get('q') ?? '';

    const applyFilters = () => {
      const query = searchInput?.value.trim().toLowerCase() ?? '';
      let visibleCount = 0;

      items.forEach((item) => {
        const matchesQuery = !query || item.dataset.search?.includes(query);
        const matchesCategory = !activeCategory || item.dataset.category === activeCategory;
        const itemTags = item.dataset.tags?.split('|') ?? [];
        const matchesTag = !activeTag || itemTags.includes(activeTag);
        const isVisible = Boolean(matchesQuery && matchesCategory && matchesTag);
        item.hidden = !isVisible;
        if (isVisible) visibleCount += 1;
      });

      categoryButtons.forEach((button) => {
        const isActive = (button.dataset.categoryFilter ?? '') === activeCategory;
        button.classList.toggle('is-active', isActive);
        button.setAttribute('aria-pressed', String(isActive));
      });

      tagButtons.forEach((button) => {
        const isActive = (button.dataset.tagFilter ?? '') === activeTag;
        button.classList.toggle('is-active', isActive);
        button.setAttribute('aria-pressed', String(isActive));
      });

      if (resultCount) resultCount.textContent = `${visibleCount} ${visibleCount === 1 ? 'article' : 'articles'}`;
      if (emptyState) emptyState.hidden = visibleCount !== 0;

      const nextParams = new URLSearchParams();
      if (query) nextParams.set('q', query);
      if (activeCategory) nextParams.set('category', activeCategory);
      if (activeTag) nextParams.set('tag', activeTag);
      const nextUrl = nextParams.size ? `${window.location.pathname}?${nextParams}` : window.location.pathname;
      window.history.replaceState({}, '', nextUrl);
    };

    searchForm?.addEventListener('submit', (event) => {
      event.preventDefault();
      applyFilters();
    });
    searchInput?.addEventListener('input', applyFilters);

    categoryButtons.forEach((button) => {
      button.addEventListener('click', () => {
        activeCategory = button.dataset.categoryFilter ?? '';
        applyFilters();
      });
    });

    tagButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const selectedTag = button.dataset.tagFilter ?? '';
        activeTag = activeTag === selectedTag ? '' : selectedTag;
        applyFilters();
      });
    });

    clearButton?.addEventListener('click', () => {
      activeCategory = '';
      activeTag = '';
      if (searchInput) searchInput.value = '';
      applyFilters();
      searchInput?.focus();
    });

    applyFilters();
  }
</script>

<style>
  .blog-hero{min-height:600px;padding:210px 0 105px;text-align:center;background:url('/images/hero-bg.svg') center top/cover no-repeat}.blog-hero h1{max-width:900px;margin:18px auto 20px;font-size:72px;letter-spacing:-.045em}.blog-hero p{max-width:680px;margin:auto}.blog-hero nav{display:flex;justify-content:center;gap:12px;margin-top:30px;font-size:13px}.blog-hero nav strong{color:#fff}.blog-section{padding:100px 0 150px}.blog-tools{display:flex;justify-content:space-between;align-items:center;gap:25px;margin-bottom:24px}.blog-search{display:grid;grid-template-columns:minmax(0,520px) auto;flex:1}.blog-search input{width:100%;min-height:54px;padding:13px 18px;border:1px solid var(--border);border-radius:10px 0 0 10px;background:#111b2e;color:#fff}.blog-search button{padding:0 22px;border:0;border-radius:0 10px 10px 0;background:var(--lime);color:#090d16;font-weight:700}.blog-count{font-size:13px;white-space:nowrap}.category-filters{display:flex;flex-wrap:wrap;gap:9px;margin-bottom:48px}.category-filters button,.tag-list button,.nothing button{border:1px solid var(--border);background:var(--surface);color:#fff}.category-filters button{padding:9px 15px;border-radius:999px;font-size:12px}.category-filters button:hover,.category-filters button.is-active,.tag-list button:hover,.tag-list button.is-active{border-color:var(--lime);background:rgba(185,251,106,.1);color:var(--lime)}.blog-layout{display:grid;grid-template-columns:minmax(0,2.15fr) minmax(270px,.85fr);gap:55px}.blog-grid{display:grid;gap:25px}.nothing{padding:75px 25px;border:1px dashed var(--border);border-radius:15px;text-align:center;background:var(--surface)}.nothing[hidden]{display:none}.nothing>span{display:block;color:var(--lime);font-size:45px}.nothing h2{margin:14px 0;font-size:32px}.nothing button{margin-top:22px;padding:11px 17px;border-radius:999px}.sidebar{display:grid;align-content:start;gap:22px}.sidebar>section{padding:30px;border:1px solid var(--border);border-radius:12px;background:var(--surface)}.sidebar h2{margin-bottom:22px;font-size:18px}.recent-posts{display:grid;gap:19px;margin:0;padding:0;list-style:none;counter-reset:posts}.recent-posts li{display:grid;grid-template-columns:28px 1fr;gap:2px 10px;counter-increment:posts}.recent-posts li::before{grid-row:1/3;color:var(--lime);font-family:var(--heading);font-weight:700;content:counter(posts,decimal-leading-zero)}.recent-posts a{color:#fff;font-size:13px;font-weight:600;line-height:1.45}.recent-posts time{font-size:11px}.tag-list{display:flex;flex-wrap:wrap;gap:8px}.tag-list button{display:inline-flex;gap:7px;padding:7px 10px;border-radius:999px;font-size:11px}.tag-list button span{opacity:.6}.sidebar-cta{background:var(--lime)!important;color:#1b2912!important}.sidebar-cta .eyebrow{background:#fff}.sidebar-cta h2{margin:20px 0 14px;color:#090d16;font-size:25px}.sidebar-cta p{margin-bottom:22px}.sidebar-cta :global(.button){width:100%;background:#090d16;border-color:#090d16}
  @media(max-width:900px){.blog-layout{grid-template-columns:1fr}.sidebar{grid-template-columns:1fr 1fr}.sidebar-cta{grid-column:1/-1}.blog-hero{min-height:500px;padding-top:180px}.blog-hero h1{font-size:58px}}
  @media(max-width:600px){.blog-hero{min-height:420px;padding:140px 15px 70px}.blog-hero h1{font-size:40px;line-height:1.15}.blog-section{padding:70px 0 100px}.blog-tools{display:grid}.blog-search{grid-template-columns:1fr auto}.blog-search button{padding:0 14px;font-size:12px}.category-filters{margin-bottom:32px}.blog-layout{gap:40px}.sidebar{grid-template-columns:1fr}.sidebar-cta{grid-column:auto}.sidebar>section{padding:25px 22px}}
</style>
