---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import CaseStudyCard from '@/components/CaseStudyCard.astro';
import Button from '@/components/Button.astro';
import { site } from '@/data/site';

export async function getStaticPaths() {
  const cases = await getCollection('caseStudies');
  return cases.map((item) => ({ params: { slug: item.id }, props: { item } }));
}

const { item } = Astro.props;
const { Content } = await render(item);
const cases = await getCollection('caseStudies');
const related = cases.filter((entry) => entry.id !== item.id).slice(0, 2);
const canonicalUrl = `${site.url}/case-studies/${item.id}`;
const socialImage = `/images/og/${item.id}.jpg`;
const imageUrl = new URL(socialImage, site.url).toString();
const modifiedDate = (item.data.updatedDate ?? item.data.publishedDate).toISOString();
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: item.data.title,
  description: item.data.description,
  image: [imageUrl],
  datePublished: item.data.publishedDate.toISOString(),
  dateModified: modifiedDate,
  author: { '@id': `${site.url}/#organization` },
  publisher: { '@id': `${site.url}/#organization` },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
  articleSection: item.data.category,
  genre: 'Illustrative case study',
  keywords: [item.data.category, item.data.industry, ...item.data.channels].join(', '),
  inLanguage: 'en',
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
    { '@type': 'ListItem', position: 2, name: 'Case Studies', item: `${site.url}/case-studies` },
    { '@type': 'ListItem', position: 3, name: item.data.title, item: canonicalUrl },
  ],
};
---

<BaseLayout
  title={item.data.title}
  metaTitle={`${item.data.seoTitle ?? item.data.title} – ${site.name}`}
  description={item.data.description}
  image={socialImage}
  imageAlt={`${item.data.title} – illustrative Shieldify IP case study`}
  canonicalPath={`/case-studies/${item.id}`}
  ogType="article"
  publishedDate={item.data.publishedDate.toISOString()}
  modifiedDate={modifiedDate}
  articleTags={[item.data.category, item.data.industry, ...item.data.channels]}
  schema={[articleSchema, breadcrumbSchema]}
>
  <article class="case-detail">
    <header class="case-detail__hero">
      <div class="container">
        <nav aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/case-studies">Case Studies</a><span aria-hidden="true">/</span><span>{item.data.category}</span></nav>
        <span class="case-detail__label">Illustrative workflow</span>
        <h1>{item.data.title}</h1>
        <p>{item.data.description}</p>
        <div class="case-detail__meta"><span>{item.data.category}</span><span>{item.data.industry}</span>{item.data.channels.map((channel) => <span>{channel}</span>)}</div>
      </div>
    </header>

    <div class="container case-detail__layout">
      <main>
        <img class="case-detail__image" src={item.data.image} alt={item.data.imageAlt} width={item.data.imageWidth} height={item.data.imageHeight} fetchpriority="high" decoding="async" />

        <div class="case-detail__notice">
          <strong>Illustrative content</strong>
          <p>This workflow is an educational example, not a named client engagement, legal conclusion, performance claim, or guarantee that a platform or third party will take action.</p>
        </div>

        <div class="case-detail__prose"><Content /></div>
      </main>

      <aside>
        <div class="case-detail__aside">
          <span class="eyebrow">Workflow Summary</span>
          <h2>Objectives</h2>
          <ul>{item.data.objectives.map((objective) => <li>{objective}</li>)}</ul>
          <h2>Example Deliverables</h2>
          <ul>{item.data.deliverables.map((deliverable) => <li>{deliverable}</li>)}</ul>
          <Button href="/our-services#contact">Discuss Your Scenario</Button>
        </div>
      </aside>
    </div>
  </article>

  {related.length > 0 && (
    <section class="related-cases section">
      <div class="container">
        <div class="related-cases__heading"><span class="eyebrow">More Workflows</span><h2>Explore Related Case Studies</h2></div>
        <div class="related-cases__grid">
          {related.map((entry) => (
            <CaseStudyCard
              title={entry.data.title}
              description={entry.data.description}
              href={`/case-studies/${entry.id}`}
              image={entry.data.image}
              imageAlt={entry.data.imageAlt}
              imageWidth={entry.data.imageWidth}
              imageHeight={entry.data.imageHeight}
              category={entry.data.category}
              industry={entry.data.industry}
              channels={entry.data.channels}
            />
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .case-detail__hero{padding:185px 0 95px;background:url('/images/hero-bg.svg') center top/cover no-repeat}.case-detail__hero nav{display:flex;flex-wrap:wrap;gap:9px;margin-bottom:35px;font-size:12px}.case-detail__hero nav a:hover{color:var(--lime)}.case-detail__label{display:inline-flex;padding:6px 11px;border:1px solid rgba(185,251,106,.3);border-radius:999px;background:rgba(185,251,106,.1);color:var(--lime);font-size:11px;font-weight:700;letter-spacing:.03em;text-transform:uppercase}.case-detail__hero h1{max-width:1050px;margin:22px 0;font-size:64px;letter-spacing:-.04em}.case-detail__hero>div>p{max-width:790px;font-size:18px}.case-detail__meta{display:flex;flex-wrap:wrap;gap:8px;margin-top:28px}.case-detail__meta span{padding:6px 10px;border:1px solid var(--border);border-radius:999px;font-size:11px}.case-detail__layout{display:grid;grid-template-columns:minmax(0,1fr) 330px;gap:75px;padding-top:80px;padding-bottom:130px}.case-detail__image{width:100%;max-height:600px;border-radius:15px;object-fit:cover}.case-detail__notice{display:grid;grid-template-columns:160px 1fr;gap:25px;margin-top:32px;padding:23px 25px;border:1px solid rgba(185,251,106,.24);border-radius:10px;background:rgba(185,251,106,.07)}.case-detail__notice strong{color:#fff}.case-detail__notice p{font-size:13px}.case-detail__prose{max-width:850px;margin:65px auto 0;color:rgba(255,255,255,.72);font-size:17px;line-height:1.82}.case-detail__prose :global(h2){margin:58px 0 20px;font-size:37px;letter-spacing:-.025em}.case-detail__prose :global(p),.case-detail__prose :global(ul),.case-detail__prose :global(ol){margin:20px 0}.case-detail__prose :global(a){color:var(--lime);text-decoration:underline;text-underline-offset:3px}.case-detail__aside{position:sticky;top:125px;padding:30px;border:1px solid var(--border);border-radius:12px;background:var(--surface)}.case-detail__aside h2{margin:25px 0 13px;font-size:20px}.case-detail__aside ul{margin:0;padding-left:19px;font-size:13px}.case-detail__aside li+li{margin-top:9px}.case-detail__aside :global(.button){width:100%;margin-top:28px}.related-cases{background:var(--surface-dark)}.related-cases__heading{margin-bottom:45px}.related-cases__heading h2{margin-top:16px;font-size:44px}.related-cases__grid{display:grid;grid-template-columns:1fr 1fr;gap:24px}@media(max-width:950px){.case-detail__layout{grid-template-columns:1fr}.case-detail__aside{position:static}.case-detail__hero h1{font-size:52px}}@media(max-width:650px){.case-detail__hero{padding:140px 0 70px}.case-detail__hero h1{font-size:37px;line-height:1.17}.case-detail__hero>div>p{font-size:16px}.case-detail__layout{gap:45px;padding-top:45px;padding-bottom:90px}.case-detail__notice{grid-template-columns:1fr;gap:7px;padding:20px}.case-detail__prose{margin-top:45px;font-size:16px}.case-detail__prose :global(h2){font-size:29px}.related-cases__heading h2{font-size:34px}.related-cases__grid{grid-template-columns:1fr}}
</style>
