---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import CaseStudyCard from '@/components/CaseStudyCard.astro';
import { site } from '@/data/site';

const cases = (await getCollection('caseStudies')).sort(
  (a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf(),
);
const categories = [...new Set(cases.map((item) => item.data.category))].sort();
const pageDescription = 'Explore illustrative Shieldify IP workflows for trademark monitoring, copyright evidence, brand impersonation, counterfeit detection, and case management.';
const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `Case Studies – ${site.name}`,
  description: pageDescription,
  url: `${site.url}/case-studies`,
  inLanguage: 'en',
  isPartOf: { '@id': `${site.url}/#website` },
  hasPart: cases.map((item) => ({
    '@type': 'Article',
    headline: item.data.title,
    url: `${site.url}/case-studies/${item.id}`,
    genre: 'Illustrative case study',
  })),
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
    { '@type': 'ListItem', position: 2, name: 'Case Studies', item: `${site.url}/case-studies` },
  ],
};
---

<BaseLayout
  title="Case Studies"
  description={pageDescription}
  image="/images/og/case-studies.jpg"
  imageAlt="Shieldify IP illustrative case studies"
  schema={[collectionSchema, breadcrumbSchema]}
>
  <section class="case-hero">
    <div class="container">
      <nav aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">•</span><strong>Case Studies</strong></nav>
      <span class="eyebrow">Protection Workflows</span>
      <h1>IP Protection Scenarios, From Finding to Case Record</h1>
      <p>Explore practical examples of how monitoring, evidence collection, review, escalation, and reporting can work together across digital channels.</p>
    </div>
  </section>

  <section class="case-library" data-case-root>
    <div class="container">
      <div class="case-notice">
        <strong>About these case studies</strong>
        <p>These are illustrative workflows based on common operational scenarios. They are not client testimonials, legal conclusions, performance claims, or guarantees of platform action.</p>
      </div>

      <div class="case-tools">
        <div class="case-filters" aria-label="Filter case studies">
          <button type="button" class="is-active" data-case-filter="" aria-pressed="true">All workflows</button>
          {categories.map((category) => <button type="button" data-case-filter={category.toLowerCase()} aria-pressed="false">{category}</button>)}
        </div>
        <p aria-live="polite" data-case-count>{cases.length} case studies</p>
      </div>

      <div class="case-grid">
        {cases.map((item) => (
          <CaseStudyCard
            title={item.data.title}
            description={item.data.description}
            href={`/case-studies/${item.id}`}
            image={item.data.image}
            imageAlt={item.data.imageAlt}
            imageWidth={item.data.imageWidth}
            imageHeight={item.data.imageHeight}
            category={item.data.category}
            industry={item.data.industry}
            channels={item.data.channels}
          />
        ))}
      </div>
      <div class="case-empty" data-case-empty hidden><h2>No matching workflows</h2><p>Choose another category to view available case studies.</p></div>
    </div>
  </section>
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-case-root]');
  if (root) {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-case-filter]')];
    const items = [...root.querySelectorAll<HTMLElement>('[data-case-item]')];
    const count = root.querySelector<HTMLElement>('[data-case-count]');
    const empty = root.querySelector<HTMLElement>('[data-case-empty]');
    buttons.forEach((button) => button.addEventListener('click', () => {
      const category = button.dataset.caseFilter ?? '';
      let visible = 0;
      items.forEach((item) => {
        const show = !category || item.dataset.category === category;
        item.hidden = !show;
        if (show) visible += 1;
      });
      buttons.forEach((item) => {
        const active = item === button;
        item.classList.toggle('is-active', active);
        item.setAttribute('aria-pressed', String(active));
      });
      if (count) count.textContent = `${visible} ${visible === 1 ? 'case study' : 'case studies'}`;
      if (empty) empty.hidden = visible !== 0;
    }));
  }
</script>

<style>
  .case-hero{min-height:650px;padding:205px 0 105px;text-align:center;background:url('/images/hero-bg.svg') center top/cover no-repeat}.case-hero nav{display:flex;justify-content:center;gap:12px;margin-bottom:28px;font-size:13px}.case-hero h1{max-width:1000px;margin:20px auto 24px;font-size:68px;letter-spacing:-.045em}.case-hero p{max-width:730px;margin:auto}.case-library{padding:100px 0 150px}.case-notice{display:grid;grid-template-columns:220px 1fr;gap:30px;margin-bottom:48px;padding:25px 28px;border:1px solid rgba(185,251,106,.25);border-radius:12px;background:rgba(185,251,106,.07)}.case-notice strong{color:#fff}.case-notice p{font-size:14px}.case-tools{display:flex;align-items:center;justify-content:space-between;gap:25px;margin-bottom:35px}.case-tools>p{font-size:13px;white-space:nowrap}.case-filters{display:flex;flex-wrap:wrap;gap:9px}.case-filters button{padding:9px 15px;border:1px solid var(--border);border-radius:999px;background:var(--surface);color:#fff;font-size:12px}.case-filters button:hover,.case-filters button.is-active{border-color:var(--lime);background:rgba(185,251,106,.1);color:var(--lime)}.case-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}.case-empty{padding:65px 25px;text-align:center}.case-empty[hidden]{display:none}.case-empty h2{margin-bottom:12px}@media(max-width:950px){.case-grid{grid-template-columns:1fr 1fr}.case-hero h1{font-size:54px}}@media(max-width:650px){.case-hero{min-height:500px;padding:145px 15px 75px}.case-hero h1{font-size:38px;line-height:1.17}.case-library{padding:70px 0 100px}.case-notice{grid-template-columns:1fr;gap:8px;padding:22px}.case-tools{display:grid}.case-grid{grid-template-columns:1fr}}
</style>
