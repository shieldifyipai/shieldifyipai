---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import CaseStudyCard from '@/components/CaseStudyCard.astro';
import BlogCard from '@/components/BlogCard.astro';
import { site } from '@/data/site';

export async function getStaticPaths() {
  const industries = await getCollection('industries');
  return industries.map((item) => ({ params: { slug: item.id }, props: { item } }));
}

const { item } = Astro.props;
const { Content } = await render(item);
const services = await getCollection('servicePages');
const caseStudies = await getCollection('caseStudies');
const blogPosts = await getCollection('blog');
const recommendedServices = item.data.recommendedServices.flatMap((id: string) => {
  const service = services.find((entry) => entry.id === id);
  return service ? [service] : [];
});
const relatedCase = item.data.relatedCase ? caseStudies.find((entry) => entry.id === item.data.relatedCase) : undefined;
const relatedBlog = item.data.relatedBlog ? blogPosts.find((entry) => entry.id === item.data.relatedBlog) : undefined;
const canonicalUrl = `${site.url}/industries/${item.id}`;
const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: item.data.title,
  description: item.data.description,
  url: canonicalUrl,
  serviceType: 'Digital intellectual property protection',
  provider: { '@id': `${site.url}/#organization` },
  areaServed: 'Worldwide',
  audience: { '@type': 'BusinessAudience', audienceType: item.data.title },
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
    { '@type': 'ListItem', position: 2, name: 'Industries', item: `${site.url}/industries` },
    { '@type': 'ListItem', position: 3, name: item.data.title, item: canonicalUrl },
  ],
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: item.data.faqs.map(({ question, answer }) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
};
---

<BaseLayout
  title={item.data.title}
  metaTitle={`${item.data.seoTitle ?? item.data.title} - ${site.name}`}
  description={item.data.description}
  image={item.data.heroImage}
  imageAlt={item.data.heroImageAlt}
  canonicalPath={`/industries/${item.id}`}
  schema={[pageSchema, breadcrumbSchema, faqSchema]}
>
  <section class="industry-detail-hero">
    <div class="container">
      <nav aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/industries">Industries</a><span aria-hidden="true">/</span><span>{item.data.title}</span></nav>
      <div class="industry-detail-hero__grid">
        <div>
          <span class="eyebrow">Industry Solution</span>
          <div class="industry-detail-hero__title"><img src={item.data.icon} alt="" width="48" height="48" /><h1>{item.data.title}</h1></div>
          <p>{item.data.description}</p>
          <div class="industry-detail-hero__actions"><Button href="/our-services#contact">Request a Consultation</Button><Button href="#industry-priorities" variant="outline">Explore Priorities</Button></div>
          <div class="industry-detail-hero__channels">{item.data.channels.map((channel) => <span>{channel}</span>)}</div>
        </div>
        <img src={item.data.heroImage} alt={item.data.heroImageAlt} width={item.data.heroImageWidth} height={item.data.heroImageHeight} fetchpriority="high" decoding="async" />
      </div>
    </div>
  </section>

  <section class="industry-overview section">
    <div class="container industry-overview__grid">
      <main class="industry-prose"><Content /></main>
      <aside>
        <span class="eyebrow">Industry Focus</span>
        <h2>Digital Environments in Scope</h2>
        <ul>{item.data.channels.map((channel) => <li>{channel}</li>)}</ul>
        <a href="/our-services">Explore all protection services <span aria-hidden="true">→</span></a>
      </aside>
    </div>
  </section>

  <section class="industry-challenges section section--soft">
    <div class="container">
      <div class="industry-heading"><span class="eyebrow">Operating Challenges</span><h2>Why This Environment Needs a Defined Review Process</h2><p>Common signals become more useful when teams preserve context, connect ownership information and apply consistent review standards.</p></div>
      <div class="industry-challenges__grid">{item.data.challenges.map((challenge, index) => <article class="reveal"><span>{String(index + 1).padStart(2, '0')}</span><h3>{challenge.title}</h3><p>{challenge.description}</p></article>)}</div>
    </div>
  </section>

  <section class="industry-priorities section" id="industry-priorities">
    <div class="container">
      <div class="industry-heading"><span class="eyebrow">Protection Priorities</span><h2>A More Relevant IP Protection Scope</h2><p>Configure the monitoring, evidence and case workflow around the assets and channels that matter most to the organization.</p></div>
      <div class="industry-priorities__grid">{item.data.priorities.map((priority, index) => <article class="reveal"><span>{String(index + 1).padStart(2, '0')}</span><h3>{priority.title}</h3><p>{priority.description}</p></article>)}</div>
    </div>
  </section>

  <section class="industry-services section section--soft">
    <div class="container">
      <div class="industry-heading"><span class="eyebrow">Recommended Services</span><h2>Connect the Right Protection Capabilities</h2><p>These services form a practical starting point for this industry. Final scope depends on rights, channels, territories and operating priorities.</p></div>
      <div class="industry-services__grid">
        {recommendedServices.map((service) => (
          <article class="reveal">
            <img src={service.data.icon} alt="" width="42" height="42" loading="lazy" decoding="async" />
            <h3>{service.data.title}</h3>
            <p>{service.data.navDescription}</p>
            <a href={`/our-services/${service.id}`}>Explore service <span aria-hidden="true">→</span></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="industry-workflow section">
    <div class="container">
      <div class="industry-heading"><span class="eyebrow">Industry Workflow</span><h2>From Scope to Accountable Reporting</h2><p>A repeatable process keeps findings, evidence, review, action and outcomes connected.</p></div>
      <ol class="industry-workflow__grid">{item.data.workflow.map((step, index) => <li class="reveal"><span>{String(index + 1).padStart(2, '0')}</span><h3>{step.title}</h3><p>{step.description}</p></li>)}</ol>
    </div>
  </section>

  {(relatedCase || relatedBlog) && (
    <section class="industry-related section section--soft">
      <div class="container">
        <div class="industry-heading"><span class="eyebrow">Related Resources</span><h2>Explore the Supporting Workflow</h2></div>
        <div class="industry-related__grid">
          {relatedCase && <CaseStudyCard title={relatedCase.data.title} description={relatedCase.data.description} href={`/case-studies/${relatedCase.id}`} image={relatedCase.data.image} imageAlt={relatedCase.data.imageAlt} imageWidth={relatedCase.data.imageWidth} imageHeight={relatedCase.data.imageHeight} category={relatedCase.data.category} industry={relatedCase.data.industry} channels={relatedCase.data.channels} />}
          {relatedBlog && <BlogCard title={relatedBlog.data.title} description={relatedBlog.data.description} href={`/blog/${relatedBlog.id}`} image={relatedBlog.data.image} imageAlt={relatedBlog.data.imageAlt} imageWidth={relatedBlog.data.imageWidth} imageHeight={relatedBlog.data.imageHeight} date={relatedBlog.data.publishedDate} category={relatedBlog.data.category} tags={relatedBlog.data.tags} />}
        </div>
      </div>
    </section>
  )}

  <section class="industry-faq section">
    <div class="container industry-faq__layout">
      <div><span class="eyebrow">FAQs</span><h2>Questions About {item.data.title}</h2><p>A defined scope and clear review responsibilities help organizations choose a realistic protection workflow.</p><Button href="/our-services#contact" variant="outline">Discuss Your Environment</Button></div>
      <div class="industry-faq__items">{item.data.faqs.map(({ question, answer }, index) => <details open={index === 0}><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div>
    </div>
  </section>
</BaseLayout>

<style>
  .industry-detail-hero{min-height:850px;padding:155px 0 100px;background:url('/images/hero-bg.svg') center top/cover no-repeat}.industry-detail-hero nav{display:flex;flex-wrap:wrap;gap:9px;margin-bottom:58px;font-size:12px}.industry-detail-hero nav a:hover{color:var(--lime)}.industry-detail-hero__grid{display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:center}.industry-detail-hero__title{display:grid;gap:18px;margin:20px 0}.industry-detail-hero__title img{width:48px;height:48px;padding:9px;border:1px solid rgba(185,251,106,.25);border-radius:11px;background:rgba(185,251,106,.08)}.industry-detail-hero h1{max-width:720px;font-size:58px;letter-spacing:-.045em}.industry-detail-hero__grid>div>p{max-width:680px;font-size:18px}.industry-detail-hero__grid>img{width:100%;height:500px;border:1px solid var(--border);border-radius:16px;object-fit:cover;box-shadow:0 30px 80px rgba(0,0,0,.32)}.industry-detail-hero__actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:30px}.industry-detail-hero__channels{display:flex;flex-wrap:wrap;gap:8px;margin-top:30px}.industry-detail-hero__channels span{padding:6px 10px;border:1px solid var(--border);border-radius:999px;font-size:10px}.industry-overview__grid{display:grid;grid-template-columns:minmax(0,1fr) 360px;gap:100px}.industry-prose{max-width:820px;font-size:17px;line-height:1.82}.industry-prose :global(h2){margin:0 0 22px;font-size:39px;letter-spacing:-.025em}.industry-prose :global(h2:not(:first-child)){margin-top:58px}.industry-prose :global(p){margin:20px 0}.industry-overview aside{align-self:start;padding:32px;border:1px solid var(--border);border-radius:13px;background:var(--surface)}.industry-overview aside h2{margin:22px 0;font-size:27px}.industry-overview aside ul{margin:0 0 25px;padding:0;list-style:none}.industry-overview aside li{padding:10px 0;border-bottom:1px solid var(--border);font-size:13px}.industry-overview aside li::before{margin-right:10px;color:var(--lime);content:'✓'}.industry-overview aside>a{display:flex;gap:8px;color:var(--lime);font-size:12px;font-weight:700}.industry-heading{max-width:790px;margin-bottom:55px}.industry-heading h2{margin:18px 0;font-size:48px;letter-spacing:-.035em}.industry-challenges__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.industry-challenges article{min-height:285px;padding:34px;border:1px solid var(--border);border-radius:13px;background:#090d16}.industry-challenges article>span{color:var(--lime);font-size:12px;font-weight:800}.industry-challenges h3{margin:42px 0 15px;font-size:23px}.industry-challenges p{font-size:14px}.industry-priorities__grid,.industry-workflow__grid{display:grid;grid-template-columns:repeat(4,1fr);gap:0}.industry-priorities article,.industry-workflow li{padding:31px;border-top:1px solid var(--border);border-bottom:1px solid var(--border)}.industry-priorities article+article,.industry-workflow li+li{border-left:1px solid var(--border)}.industry-priorities article>span,.industry-workflow li>span{display:grid;place-items:center;width:42px;height:42px;margin-bottom:27px;border-radius:10px;background:var(--lime);color:#090d16;font-size:12px;font-weight:800}.industry-priorities h3,.industry-workflow h3{margin-bottom:14px;font-size:20px}.industry-priorities p,.industry-workflow p{font-size:14px}.industry-workflow__grid{margin:0;padding:0;list-style:none}.industry-services__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.industry-services article{display:flex;flex-direction:column;min-height:310px;padding:34px;border:1px solid var(--border);border-radius:13px;background:#090d16}.industry-services article>img{width:48px;height:48px;padding:11px;border-radius:11px;background:rgba(185,251,106,.09)}.industry-services h3{margin:30px 0 14px;font-size:22px}.industry-services p{font-size:14px}.industry-services a{display:inline-flex;gap:8px;margin-top:auto;padding-top:24px;color:var(--lime);font-size:13px;font-weight:700}.industry-related__grid{display:grid;grid-template-columns:1fr 1fr;gap:24px}.industry-faq__layout{display:grid;grid-template-columns:1fr 1.35fr;gap:90px}.industry-faq__layout>div:first-child h2{margin:20px 0;font-size:44px}.industry-faq__layout>div:first-child p{max-width:470px;margin-bottom:27px}.industry-faq__items{border-top:1px solid var(--border)}.industry-faq__items details{padding:0 24px;border-bottom:1px solid var(--border);background:var(--surface)}.industry-faq__items summary{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:24px 0;color:#fff;font-family:var(--heading);font-weight:700;cursor:pointer;list-style:none}.industry-faq__items summary::-webkit-details-marker{display:none}.industry-faq__items summary span{display:grid;place-items:center;flex:0 0 30px;width:30px;height:30px;border-radius:50%;background:var(--surface-2)}.industry-faq__items details[open] summary span{background:var(--lime);color:#090d16;transform:rotate(45deg)}.industry-faq__items p{padding:0 0 24px}@media(max-width:1050px){.industry-detail-hero__grid{grid-template-columns:1fr;gap:45px}.industry-detail-hero__grid>img{height:auto}.industry-overview__grid{grid-template-columns:1fr;gap:50px}.industry-challenges__grid{grid-template-columns:1fr 1fr}.industry-priorities__grid,.industry-workflow__grid{grid-template-columns:1fr 1fr}.industry-priorities article:nth-child(3),.industry-workflow li:nth-child(3){border-left:0}.industry-services__grid{grid-template-columns:1fr 1fr}.industry-faq__layout{grid-template-columns:1fr;gap:50px}}@media(max-width:650px){.industry-detail-hero{min-height:auto;padding:130px 0 75px}.industry-detail-hero nav{margin-bottom:38px}.industry-detail-hero h1{font-size:38px;line-height:1.16}.industry-detail-hero__grid>div>p{font-size:16px}.industry-detail-hero__actions{display:grid}.industry-detail-hero__actions :global(.button){width:100%}.industry-overview__grid{gap:35px}.industry-prose{font-size:16px}.industry-prose :global(h2){font-size:30px}.industry-heading h2{font-size:33px}.industry-challenges__grid,.industry-priorities__grid,.industry-workflow__grid,.industry-services__grid,.industry-related__grid{grid-template-columns:1fr}.industry-challenges article,.industry-services article{min-height:auto}.industry-priorities article+article,.industry-workflow li+li{border-left:0}.industry-faq__layout>div:first-child h2{font-size:33px}.industry-faq__items details{padding:0 17px}}
</style>
