---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import CaseStudyCard from '@/components/CaseStudyCard.astro';
import BlogCard from '@/components/BlogCard.astro';
import { site } from '@/data/site';

export async function getStaticPaths() {
  const services = await getCollection('servicePages');
  return services.map((item) => ({ params: { slug: item.id }, props: { item } }));
}

const { item } = Astro.props;
const { Content } = await render(item);
const caseStudies = await getCollection('caseStudies');
const blogPosts = await getCollection('blog');
const relatedCase = item.data.relatedCase ? caseStudies.find((entry) => entry.id === item.data.relatedCase) : undefined;
const relatedBlog = item.data.relatedBlog ? blogPosts.find((entry) => entry.id === item.data.relatedBlog) : undefined;
const canonicalUrl = `${site.url}/our-services/${item.id}`;
const socialImage = `/images/og/service-${item.id}.jpg`;
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: item.data.title,
  description: item.data.description,
  url: canonicalUrl,
  serviceType: item.data.title,
  provider: { '@id': `${site.url}/#organization` },
  areaServed: 'Worldwide',
  audience: item.data.suitedFor.map((name) => ({ '@type': 'Audience', audienceType: name })),
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
    { '@type': 'ListItem', position: 2, name: 'Our Services', item: `${site.url}/our-services` },
    { '@type': 'ListItem', position: 3, name: item.data.title, item: canonicalUrl },
  ],
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: item.data.faqs.map(({ question, answer }) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
};
---

<BaseLayout
  title={item.data.title}
  metaTitle={`${item.data.seoTitle ?? item.data.title} – ${site.name}`}
  description={item.data.description}
  image={socialImage}
  imageAlt={`${item.data.title} – Shieldify IP`}
  canonicalPath={`/our-services/${item.id}`}
  schema={[serviceSchema, breadcrumbSchema, faqSchema]}
>
  <section class="service-detail-hero">
    <div class="container">
      <nav aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/our-services">Our Services</a><span aria-hidden="true">/</span><span>{item.data.title}</span></nav>
      <div class="service-detail-hero__grid">
        <div>
          <span class="eyebrow">IP Protection Service</span>
          <div class="service-detail-hero__title"><img src={item.data.icon} alt="" width="48" height="48" /><h1>{item.data.title}</h1></div>
          <p>{item.data.description}</p>
          <div class="service-detail-hero__actions"><Button href="/our-services#contact">Request a Consultation</Button><Button href="#capabilities" variant="outline">Explore Capabilities</Button></div>
          <div class="service-detail-hero__channels" aria-label="Coverage channels">{item.data.channels.map((channel) => <span>{channel}</span>)}</div>
        </div>
        <img src={item.data.heroImage} alt={item.data.heroImageAlt} width={item.data.heroImageWidth} height={item.data.heroImageHeight} fetchpriority="high" decoding="async" />
      </div>
    </div>
  </section>

  <section class="service-overview section">
    <div class="container service-overview__grid">
      <main class="service-prose"><Content /></main>
      <aside>
        <span class="eyebrow">Who It Supports</span>
        <h2>Built for Teams Managing Digital IP Risk</h2>
        <ul>{item.data.suitedFor.map((audience) => <li>{audience}</li>)}</ul>
        <a href="/case-studies">Explore illustrative case workflows <span aria-hidden="true">→</span></a>
      </aside>
    </div>
  </section>

  <section class="service-capabilities section section--soft" id="capabilities">
    <div class="container">
      <div class="service-heading"><span class="eyebrow">Capabilities</span><h2>What This Service Helps Organize</h2><p>Each engagement is scoped around the rights, channels, evidence standards, and review responsibilities relevant to the organization.</p></div>
      <div class="service-capabilities__grid">{item.data.capabilities.map((capability, index) => <article class="reveal"><span>{String(index + 1).padStart(2, '0')}</span><h3>{capability.title}</h3><p>{capability.description}</p></article>)}</div>
    </div>
  </section>

  <section class="service-workflow section">
    <div class="container">
      <div class="service-heading"><span class="eyebrow">Delivery Workflow</span><h2>From Scope to Transparent Reporting</h2><p>A repeatable sequence keeps findings, evidence, decisions, actions, and outcomes connected.</p></div>
      <ol class="service-workflow__grid">{item.data.workflow.map((step, index) => <li class="reveal"><span>{String(index + 1).padStart(2, '0')}</span><h3>{step.title}</h3><p>{step.description}</p></li>)}</ol>
    </div>
  </section>

  {(relatedCase || relatedBlog) && (
    <section class="service-related section section--soft">
      <div class="container">
        <div class="service-heading"><span class="eyebrow">Related Resources</span><h2>Continue Exploring This Workflow</h2></div>
        <div class="service-related__grid">
          {relatedCase && <CaseStudyCard title={relatedCase.data.title} description={relatedCase.data.description} href={`/case-studies/${relatedCase.id}`} image={relatedCase.data.image} imageAlt={relatedCase.data.imageAlt} imageWidth={relatedCase.data.imageWidth} imageHeight={relatedCase.data.imageHeight} category={relatedCase.data.category} industry={relatedCase.data.industry} channels={relatedCase.data.channels} />}
          {relatedBlog && <BlogCard title={relatedBlog.data.title} description={relatedBlog.data.description} href={`/blog/${relatedBlog.id}`} image={relatedBlog.data.image} imageAlt={relatedBlog.data.imageAlt} imageWidth={relatedBlog.data.imageWidth} imageHeight={relatedBlog.data.imageHeight} date={relatedBlog.data.publishedDate} category={relatedBlog.data.category} tags={relatedBlog.data.tags} />}
        </div>
      </div>
    </section>
  )}

  <section class="service-faq section">
    <div class="container service-faq__layout">
      <div><span class="eyebrow">FAQs</span><h2>Questions About {item.data.title}</h2><p>Clear expectations help teams choose the right monitoring, evidence, and response workflow.</p><Button href="/our-services#contact" variant="outline">Ask About Your Scenario</Button></div>
      <div class="service-faq__items">{item.data.faqs.map(({ question, answer }, index) => <details open={index === 0}><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div>
    </div>
  </section>
</BaseLayout>

<style>
  .service-detail-hero{min-height:850px;padding:155px 0 100px;background:url('/images/hero-bg.svg') center top/cover no-repeat}.service-detail-hero nav{display:flex;flex-wrap:wrap;gap:9px;margin-bottom:58px;font-size:12px}.service-detail-hero nav a:hover{color:var(--lime)}.service-detail-hero__grid{display:grid;grid-template-columns:1fr 1fr;gap:75px;align-items:center}.service-detail-hero__title{display:flex;align-items:center;gap:18px;margin:20px 0}.service-detail-hero__title img{width:48px;height:48px;padding:9px;border:1px solid rgba(185,251,106,.25);border-radius:11px;background:rgba(185,251,106,.08)}.service-detail-hero h1{max-width:720px;font-size:64px;letter-spacing:-.045em}.service-detail-hero__grid>div>p{max-width:680px;font-size:18px}.service-detail-hero__grid>img{width:100%;height:510px;border:1px solid var(--border);border-radius:16px;object-fit:cover;box-shadow:0 30px 80px rgba(0,0,0,.32)}.service-detail-hero__actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:30px}.service-detail-hero__channels{display:flex;flex-wrap:wrap;gap:8px;margin-top:30px}.service-detail-hero__channels span{padding:6px 10px;border:1px solid var(--border);border-radius:999px;font-size:10px}.service-overview__grid{display:grid;grid-template-columns:minmax(0,1fr) 360px;gap:100px}.service-prose{max-width:820px;color:rgba(255,255,255,.72);font-size:17px;line-height:1.82}.service-prose :global(h2){margin:0 0 22px;font-size:39px;letter-spacing:-.025em}.service-prose :global(h2:not(:first-child)){margin-top:58px}.service-prose :global(p){margin:20px 0}.service-overview aside{align-self:start;padding:32px;border:1px solid var(--border);border-radius:13px;background:var(--surface)}.service-overview aside h2{margin:22px 0;font-size:27px}.service-overview aside ul{margin:0 0 25px;padding:0;list-style:none}.service-overview aside li{padding:10px 0;border-bottom:1px solid var(--border);font-size:13px}.service-overview aside li::before{margin-right:10px;color:var(--lime);content:'✓'}.service-overview aside>a{display:flex;gap:8px;color:var(--lime);font-size:12px;font-weight:700}.service-heading{max-width:760px;margin-bottom:55px}.service-heading h2{margin:18px 0;font-size:48px;letter-spacing:-.035em}.service-capabilities__grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}.service-capabilities article{min-height:280px;padding:31px;border:1px solid var(--border);border-radius:12px;background:#090d16}.service-capabilities article>span,.service-workflow li>span{display:grid;place-items:center;width:42px;height:42px;margin-bottom:27px;border-radius:10px;background:var(--lime);color:#090d16;font-size:12px;font-weight:800}.service-capabilities h3,.service-workflow h3{margin-bottom:14px;font-size:20px}.service-capabilities p,.service-workflow p{font-size:14px}.service-workflow__grid{display:grid;grid-template-columns:repeat(4,1fr);gap:0;margin:0;padding:0;list-style:none;counter-reset:steps}.service-workflow li{position:relative;padding:30px;border-top:1px solid var(--border);border-bottom:1px solid var(--border)}.service-workflow li+li{border-left:1px solid var(--border)}.service-related__grid{display:grid;grid-template-columns:1fr 1fr;gap:24px}.service-faq__layout{display:grid;grid-template-columns:1fr 1.35fr;gap:90px}.service-faq__layout>div:first-child h2{margin:20px 0;font-size:45px}.service-faq__layout>div:first-child p{max-width:470px;margin-bottom:27px}.service-faq__items{border-top:1px solid var(--border)}.service-faq__items details{padding:0 24px;border-bottom:1px solid var(--border);background:var(--surface)}.service-faq__items summary{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:24px 0;color:#fff;font-family:var(--heading);font-weight:700;cursor:pointer;list-style:none}.service-faq__items summary::-webkit-details-marker{display:none}.service-faq__items summary span{display:grid;place-items:center;flex:0 0 30px;width:30px;height:30px;border-radius:50%;background:var(--surface-2)}.service-faq__items details[open] summary span{background:var(--lime);color:#090d16;transform:rotate(45deg)}.service-faq__items p{padding:0 0 24px}@media(max-width:1050px){.service-detail-hero__grid{grid-template-columns:1fr;gap:45px}.service-detail-hero__grid>img{height:auto}.service-overview__grid{grid-template-columns:1fr;gap:50px}.service-capabilities__grid,.service-workflow__grid{grid-template-columns:1fr 1fr}.service-workflow li:nth-child(3){border-left:0}.service-faq__layout{grid-template-columns:1fr;gap:50px}}@media(max-width:650px){.service-detail-hero{min-height:auto;padding:130px 0 75px}.service-detail-hero nav{margin-bottom:38px}.service-detail-hero__title{align-items:flex-start}.service-detail-hero h1{font-size:38px;line-height:1.16}.service-detail-hero__grid>div>p{font-size:16px}.service-detail-hero__actions{display:grid}.service-detail-hero__actions :global(.button){width:100%}.service-overview__grid{gap:35px}.service-prose{font-size:16px}.service-prose :global(h2){font-size:30px}.service-heading h2{font-size:33px}.service-capabilities__grid,.service-workflow__grid,.service-related__grid{grid-template-columns:1fr}.service-capabilities article{min-height:auto}.service-workflow li+li{border-left:0}.service-faq__layout>div:first-child h2{font-size:33px}.service-faq__items details{padding:0 17px}}
</style>
