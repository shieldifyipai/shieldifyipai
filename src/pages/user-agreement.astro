---
import BaseLayout from '@/layouts/BaseLayout.astro';
import LegalPage from '@/components/LegalPage.astro';
const sections = [
  {title:'Important',paragraphs:['Shieldify IP helps organize review, evidence, and enforcement support for public digital IP matters. Platform decisions remain with the relevant third-party platforms and providers.']},
  {title:'1. Acceptance of Terms',paragraphs:['By accessing this website, submitting an inquiry, or providing materials to Shieldify IP, you agree to this User Agreement and our Privacy Policy. If you do not agree, do not use the website or submit case materials.']},
  {title:'2. Services',paragraphs:['Shieldify IP provides brand protection, trademark misuse review, copyright enforcement support, counterfeit signal review, impersonation review, brand monitoring, evidence organization, reporting, and case workflow support.','We do not guarantee that any platform, marketplace, registrar, host, search engine, or third party will remove content, suspend an account, or take a specific enforcement action.']},
  {title:'3. Authorized Use',paragraphs:['You may use the website and inquiry forms only for lawful purposes and only to submit accurate, relevant information. You must not misuse the website, interfere with its operation, attempt unauthorized access, or submit malicious, unlawful, misleading, or irrelevant material.']},
  {title:'4. Information You Submit',paragraphs:['You are responsible for the accuracy of URLs, screenshots, ownership details, product references, account names, descriptions, documents, and other materials you submit. You confirm that you have the right or authority to provide the materials and request review.']},
  {title:'5. Intellectual Property Rights',paragraphs:['You retain ownership of materials you submit. You grant Shieldify IP permission to use, review, organize, store, reproduce, summarize, and share those materials as reasonably needed to evaluate your request, provide services, communicate with you, and support authorized enforcement workflows.']},
  {title:'6. Confidentiality and Sensitive Materials',paragraphs:['Do not submit trade secrets, privileged legal advice, unnecessary personal data, or highly sensitive materials unless specifically requested. We handle submitted case materials according to our Privacy Policy and reasonable service needs.']},
  {title:'7. No Legal Representation by Website Use',paragraphs:['Submitting a form or browsing this website does not create an attorney-client relationship, legal representation, or formal engagement. Any formal engagement, if applicable, must be agreed separately in writing.']},
  {title:'8. Third-Party Platforms',paragraphs:['Infringement reports, takedown notices, marketplace complaints, search engine requests, registrar reports, and similar workflows may be governed by third-party rules. Shieldify IP is not responsible for third-party delays, decisions, policy changes, or outcomes.']},
  {title:'9. Fees and Payment',paragraphs:['If paid services are agreed, pricing, scope, payment timing, and deliverables will be described separately. Unless otherwise stated in a written agreement, submitting an inquiry does not create a payment obligation.']},
  {title:'10. Disclaimers',paragraphs:['The website and general information are provided for informational and service inquiry purposes. We do not promise uninterrupted access, error-free operation, or a specific enforcement result.']},
  {title:'11. Limitation of Liability',paragraphs:['To the maximum extent permitted by law, Shieldify IP is not liable for indirect, incidental, consequential, special, punitive, or lost-profit damages arising from website use, submitted materials, third-party platform decisions, or unavailable services.']},
  {title:'12. Changes to These Terms',paragraphs:['We may update this User Agreement from time to time. The updated version will be posted on this page with a revised “Last updated” date.']},
  {title:'13. Contact',paragraphs:['Questions about this User Agreement can be sent to info@shieldifyip.com.']},
];
---
<BaseLayout title="User Agreement" description="Terms for using the Shieldify IP website, inquiry forms, submitted case materials, and intellectual property protection workflows."><LegalPage title="User Agreement" intro="These terms describe how visitors, clients, and authorized representatives may use Shieldify IP’s website, inquiry forms, and related intellectual property protection workflows." updated="August 10, 2026" sections={sections} /></BaseLayout>
