---
import Button from '@/components/Button.astro';
import ChannelIcon from '@/components/ChannelIcon.astro';

const channels = [
  { label: 'Websites & Domains', icon: 'web' },
  { label: 'Marketplaces', icon: 'marketplace' },
  { label: 'Search', icon: 'search' },
  { label: 'Social Media', icon: 'social' },
  { label: 'Video', icon: 'video' },
  { label: 'Apps', icon: 'apps' },
  { label: 'Advertising', icon: 'advertising' },
] as const;
---

<section class="home-hero">
  <div class="container home-hero__content reveal">
    <span class="eyebrow">Intellectual Property Protection</span>
    <h1>Protect Your Brand<br />Across the Digital World</h1>
    <p>Connect monitoring, evidence, professional review and enforcement support in one accountable workflow for trademarks, copyrights and digital brand assets.</p>
    <div class="home-hero__actions"><Button href="/our-services">Explore Our Services</Button><Button href="/our-services#contact" variant="outline">Request a Consultation</Button></div>
  </div>

  <div class="container home-hero__visual reveal">
    <div class="home-hero__visual-top"><span>Shieldify IP Protection Workspace</span><small><i></i> Structured monitoring</small></div>
    <img src="/images/shieldify-services-hero-ai.webp" alt="Shieldify IP monitoring, evidence and enforcement workspace" width="1718" height="916" fetchpriority="high" decoding="async" />
    <div class="home-hero__workflow" aria-label="Protection workflow">
      <div><span>01</span><strong>Monitor</strong><small>Review relevant public signals</small></div>
      <div><span>02</span><strong>Document</strong><small>Preserve evidence and context</small></div>
      <div><span>03</span><strong>Coordinate</strong><small>Track actions and responses</small></div>
    </div>
  </div>

  <ul class="container home-hero__channels" aria-label="Digital channels">
    {channels.map((channel) => (
      <li>
        <span class="home-hero__channel-icon"><ChannelIcon name={channel.icon} /></span>
        <span>{channel.label}</span>
      </li>
    ))}
  </ul>
</section>

<style>
  .home-hero{position:relative;isolation:isolate;overflow:hidden;min-height:1040px;padding:175px 0 105px;text-align:center;background:url('/images/hero-bg.svg') center top/cover no-repeat}.home-hero::after{position:absolute;z-index:-1;inset:auto 0 0;height:38%;background:linear-gradient(transparent,var(--bg));content:''}.home-hero__content{max-width:980px}.home-hero h1{margin:19px auto 23px;font-size:76px;letter-spacing:-.058em}.home-hero__content>p{max-width:760px;margin:auto;font-size:18px}.home-hero__actions{display:flex;justify-content:center;gap:10px;margin-top:31px}.home-hero__visual{position:relative;overflow:hidden;width:min(1120px,calc(100% - 40px));margin-top:70px;border:1px solid rgba(255,255,255,.13);border-radius:17px;background:#08101d;box-shadow:0 40px 100px rgba(0,0,0,.34);text-align:left}.home-hero__visual-top{display:flex;align-items:center;justify-content:space-between;padding:16px 20px;border-bottom:1px solid var(--border);color:#fff;font-size:11px;font-weight:700}.home-hero__visual-top small{display:flex;align-items:center;gap:7px;color:var(--lime)}.home-hero__visual-top i{width:6px;height:6px;border-radius:50%;background:var(--lime);box-shadow:0 0 12px var(--lime)}.home-hero__visual>img{width:100%;height:510px;object-fit:cover}.home-hero__workflow{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--border)}.home-hero__workflow>div{display:grid;grid-template-columns:auto 1fr;gap:3px 12px;padding:20px 24px}.home-hero__workflow>div+div{border-left:1px solid var(--border)}.home-hero__workflow span{grid-row:1/3;color:var(--lime);font-size:11px;font-weight:800}.home-hero__workflow strong{color:#fff;font-size:13px}.home-hero__workflow small{font-size:11px}.home-hero__channels{display:grid;grid-template-columns:repeat(7,1fr);gap:8px;margin-top:34px;padding:0;list-style:none;text-align:left}.home-hero__channels li{display:flex;align-items:center;gap:10px;min-width:0;padding:12px 10px;border:1px solid transparent;border-radius:11px;color:var(--muted);font-size:11px;font-weight:700;transition:border-color .25s ease,background .25s ease,color .25s ease,transform .25s ease}.home-hero__channels li:hover{transform:translateY(-2px);border-color:rgba(167,255,78,.2);background:rgba(167,255,78,.055);color:#fff}.home-hero__channel-icon{display:grid;flex:0 0 38px;width:38px;height:38px;place-items:center;border:1px solid rgba(167,255,78,.18);border-radius:10px;background:rgba(167,255,78,.065);color:var(--lime)}@media(max-width:1050px){.home-hero__channels{grid-template-columns:repeat(4,1fr)}}@media(max-width:768px){.home-hero{min-height:auto;padding:145px 0 80px}.home-hero h1{font-size:50px}.home-hero__actions{display:grid}.home-hero__actions :global(.button){width:100%}.home-hero__visual{margin-top:50px}.home-hero__visual>img{height:auto}.home-hero__workflow{grid-template-columns:1fr}.home-hero__workflow>div+div{border-top:1px solid var(--border);border-left:0}.home-hero__channels{grid-template-columns:repeat(2,1fr);gap:7px}.home-hero__channels li{padding:9px 7px}}@media(max-width:520px){.home-hero h1{font-size:40px;line-height:1.12}.home-hero__content>p{font-size:16px}.home-hero__visual{width:calc(100% - 30px);border-radius:13px}.home-hero__visual-top{padding:13px;font-size:9px}.home-hero__workflow>div{padding:16px}.home-hero__channels{font-size:10px}.home-hero__channel-icon{flex-basis:34px;width:34px;height:34px;border-radius:9px}.home-hero__channel-icon :global(svg){width:19px;height:19px}}
</style>
