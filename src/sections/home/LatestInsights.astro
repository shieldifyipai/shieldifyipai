---
import { getCollection } from 'astro:content';
import Button from '@/components/Button.astro';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf())
  .slice(0, 3);
---

<section class="section home-insights">
  <div class="container">
    <div class="home-insights__heading">
      <div><span class="eyebrow">Latest Insights</span><h2>Practical Guidance for Digital IP Teams</h2></div>
      <div><p>Explore monitoring, evidence and enforcement workflow guidance written for teams managing online brand and content risk.</p><Button href="/blog" variant="outline">View All Insights</Button></div>
    </div>
    <div class="home-insights__grid">
      {posts.map((post) => (
        <article class="reveal">
          {post.data.image && <a href={`/blog/${post.id}`} class="home-insights__media" tabindex="-1" aria-hidden="true"><img src={post.data.image} alt={post.data.imageAlt ?? ''} width={post.data.imageWidth} height={post.data.imageHeight} loading="lazy" decoding="async" /></a>}
          <div class="home-insights__body">
            <div><span>{post.data.category}</span><time datetime={post.data.publishedDate.toISOString()}>{post.data.publishedDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</time></div>
            <h3><a href={`/blog/${post.id}`}>{post.data.title}</a></h3>
            <p>{post.data.description}</p>
            <a href={`/blog/${post.id}`} class="home-insights__link">Read insight <span aria-hidden="true">→</span></a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .home-insights{background:var(--surface-dark)}.home-insights__heading{display:grid;grid-template-columns:1.1fr .72fr;gap:90px;align-items:end;margin-bottom:55px}.home-insights__heading h2{max-width:720px;margin-top:18px;font-size:49px;letter-spacing:-.038em}.home-insights__heading>div:last-child p{margin-bottom:24px}.home-insights__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}.home-insights article{display:flex;flex-direction:column;overflow:hidden;border:1px solid var(--border);border-radius:14px;background:var(--surface)}.home-insights__media{overflow:hidden;aspect-ratio:16/9}.home-insights__media img{width:100%;height:100%;object-fit:cover;transition:transform .4s ease}.home-insights article:hover .home-insights__media img{transform:scale(1.025)}.home-insights__body{display:flex;flex:1;flex-direction:column;padding:28px}.home-insights__body>div{display:flex;align-items:center;justify-content:space-between;gap:10px;font-size:10px}.home-insights__body>div span{padding:5px 9px;border-radius:999px;background:rgba(185,251,106,.1);color:var(--lime)}.home-insights h3{margin:19px 0 13px;font-size:22px;line-height:1.28}.home-insights h3 a:hover{color:var(--lime)}.home-insights p{font-size:13px}.home-insights__link{display:inline-flex;gap:8px;margin-top:auto;padding-top:23px;color:var(--lime);font-size:12px;font-weight:700}@media(max-width:900px){.home-insights__heading{grid-template-columns:1fr;gap:24px}.home-insights__grid{grid-template-columns:1fr 1fr}.home-insights article:last-child{grid-column:1/-1}}@media(max-width:600px){.home-insights__heading h2{font-size:34px}.home-insights__grid{grid-template-columns:1fr}.home-insights article:last-child{grid-column:auto}}
</style>
