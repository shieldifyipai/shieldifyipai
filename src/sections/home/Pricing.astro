---
import Button from '@/components/Button.astro';
import { protectionPaths } from '@/data/home';
---

<section class="section engagement-models">
  <div class="container">
    <div class="engagement-models__heading">
      <div><span class="eyebrow">Engagement Models</span><h2>Choose the Right Operating Model</h2></div>
      <p>Start with one defined case, establish an ongoing monitoring program or configure a portfolio-level workflow. Scope and reporting depth are adapted to the organization.</p>
    </div>
    <div class="engagement-models__grid">
      {protectionPaths.map((plan, index) => (
        <article class:list={['engagement-card','reveal',{ 'is-recommended': plan.recommended }]}>
          <div class="engagement-card__top"><span>{String(index + 1).padStart(2, '0')}</span>{plan.recommended && <b>Most Flexible</b>}</div>
          <small>{plan.label}</small>
          <h3>{plan.title}</h3>
          <p>{plan.description}</p>
          <ul>{plan.features.map((feature) => <li>{feature}</li>)}</ul>
          <div class="engagement-card__action"><Button href="/our-services#contact" variant={plan.recommended ? 'primary' : 'outline'}>Discuss This Model</Button><small>{plan.note}</small></div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .engagement-models{background:url('/images/dark-bg-linear2.webp') center/cover no-repeat}.engagement-models__heading{display:grid;grid-template-columns:1.05fr .75fr;gap:90px;align-items:end;margin-bottom:56px}.engagement-models__heading h2{margin-top:18px;font-size:50px;letter-spacing:-.04em}.engagement-models__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.engagement-card{display:flex;flex-direction:column;min-height:600px;padding:36px;border:1px solid var(--border);border-radius:15px;background:#090d16}.engagement-card.is-recommended{border-color:rgba(185,251,106,.4);background:linear-gradient(180deg,rgba(185,251,106,.1),#090d16 38%);box-shadow:0 25px 65px rgba(0,0,0,.24)}.engagement-card__top{display:flex;align-items:center;justify-content:space-between;margin-bottom:42px}.engagement-card__top>span{color:var(--muted);font-size:11px;font-weight:700}.engagement-card__top b{padding:5px 9px;border-radius:999px;background:var(--lime);color:#090d16;font-size:9px;text-transform:uppercase}.engagement-card>small{color:var(--lime);font-size:10px;font-weight:700;letter-spacing:.07em;text-transform:uppercase}.engagement-card h3{margin:14px 0 16px;font-size:28px}.engagement-card>p{min-height:120px;font-size:14px}.engagement-card ul{margin:26px 0;padding:24px 0 0;border-top:1px solid var(--border);list-style:none}.engagement-card li{margin:11px 0;font-size:13px}.engagement-card li::before{margin-right:9px;color:var(--lime);content:'✓'}.engagement-card__action{display:grid;gap:14px;margin-top:auto;padding-top:25px}.engagement-card__action>small{font-size:10px;line-height:1.45}@media(max-width:900px){.engagement-models__heading{grid-template-columns:1fr;gap:24px}.engagement-models__grid{grid-template-columns:1fr}.engagement-card{min-height:auto}.engagement-card>p{min-height:auto}}@media(max-width:600px){.engagement-models__heading h2{font-size:34px}.engagement-card{padding:29px 24px}}
</style>
