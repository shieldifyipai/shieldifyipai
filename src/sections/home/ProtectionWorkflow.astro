---
import Button from '@/components/Button.astro';

const steps = [
  ['01', 'Define Rights & Scope', 'Register protected assets, ownership, authority, territories, authorized use and priority channels.'],
  ['02', 'Monitor Relevant Signals', 'Review public digital environments using references and risk priorities relevant to the organization.'],
  ['03', 'Preserve & Review Evidence', 'Connect source URLs, screenshots, timestamps and context with the applicable rights information.'],
  ['04', 'Act, Track & Report', 'Support the chosen response path and retain third-party decisions, follow-up and closure history.'],
];
---

<section class="section home-workflow">
  <div class="container">
    <div class="home-workflow__heading">
      <div><span class="eyebrow">How It Works</span><h2>One Clear Process From Scope to Case Reporting</h2></div>
      <p>Reliable IP operations keep monitoring, evidence, professional review and response history connected instead of treating each finding as an isolated task.</p>
    </div>

    <div class="home-workflow__visual reveal">
      <div>
        <span>Centralized Operating View</span>
        <h3>Understand what was found, what support exists and what happens next</h3>
        <p>A connected case record helps teams coordinate review and reporting without treating technology as an automatic legal decision-maker.</p>
        <Button href="/about-us">See How We Operate</Button>
      </div>
      <img src="/images/shieldify-workflow.svg" alt="Shieldify IP evidence and case workflow" width="1180" height="600" loading="lazy" decoding="async" />
    </div>

    <ol class="home-workflow__steps">
      {steps.map(([number, title, description]) => <li class="reveal"><span>{number}</span><h3>{title}</h3><p>{description}</p></li>)}
    </ol>

    <div class="home-workflow__coverage reveal">
      <div><span class="eyebrow">Digital Coverage</span><h2>Monitor the Channels Where IP Risk Appears</h2><p>Coverage can include public websites, domains, marketplaces, social platforms, search, video, apps, advertising, messaging and communities based on the defined scope.</p><Button href="/our-services" variant="outline">Explore Coverage</Button></div>
      <img src="/images/shieldify-digital-coverage.svg" alt="Digital channel coverage categories" width="980" height="620" loading="lazy" decoding="async" />
    </div>
  </div>
</section>

<style>
  .home-workflow__heading{display:grid;grid-template-columns:1.2fr .7fr;gap:90px;align-items:end;margin-bottom:56px}.home-workflow__heading h2{max-width:780px;margin-top:18px;font-size:51px;letter-spacing:-.04em}.home-workflow__visual{display:grid;grid-template-columns:.78fr 1.22fr;align-items:center;overflow:hidden;min-height:500px;border:1px solid var(--border);border-radius:16px;background:var(--surface)}.home-workflow__visual>div{padding:52px}.home-workflow__visual>div>span{color:var(--lime);font-size:10px;font-weight:800;letter-spacing:.07em;text-transform:uppercase}.home-workflow__visual h3{margin:20px 0;font-size:31px}.home-workflow__visual p{margin-bottom:27px}.home-workflow__visual img{align-self:end;width:100%;height:430px;object-fit:contain;object-position:right bottom}.home-workflow__steps{display:grid;grid-template-columns:repeat(4,1fr);margin:28px 0 140px;padding:0;list-style:none}.home-workflow__steps li{padding:30px;border-top:1px solid var(--border);border-bottom:1px solid var(--border)}.home-workflow__steps li+li{border-left:1px solid var(--border)}.home-workflow__steps li>span{display:grid;place-items:center;width:42px;height:42px;margin-bottom:26px;border-radius:10px;background:var(--lime);color:#090d16;font-size:12px;font-weight:800}.home-workflow__steps h3{margin-bottom:13px;font-size:19px}.home-workflow__steps p{font-size:14px}.home-workflow__coverage{display:grid;grid-template-columns:.8fr 1.2fr;gap:70px;align-items:center}.home-workflow__coverage h2{margin:20px 0;font-size:47px;letter-spacing:-.035em}.home-workflow__coverage p{margin-bottom:26px}.home-workflow__coverage img{width:100%;padding:28px;border:1px solid var(--border);border-radius:15px;background:var(--surface)}@media(max-width:900px){.home-workflow__heading,.home-workflow__visual,.home-workflow__coverage{grid-template-columns:1fr}.home-workflow__heading{gap:25px}.home-workflow__visual img{height:auto}.home-workflow__steps{grid-template-columns:1fr 1fr}.home-workflow__steps li:nth-child(3){border-left:0}.home-workflow__coverage{gap:40px}}@media(max-width:600px){.home-workflow__heading h2,.home-workflow__coverage h2{font-size:34px}.home-workflow__visual>div{padding:31px 25px}.home-workflow__visual h3{font-size:25px}.home-workflow__steps{grid-template-columns:1fr;margin-bottom:85px}.home-workflow__steps li+li{border-left:0}.home-workflow__coverage img{padding:12px}}
</style>
